generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  id            String   @id
  schemaVersion Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Client {
  id           String           @id @default(uuid())
  businessName String
  searchText   String
  status       String           @default("active")
  publicPhone  String?
  publicEmail  String?
  addressLine  String?
  locality     String?
  region       String?
  country      String?
  postalCode   String?
  category     String?
  notes        String?
  owner        String?
  archivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  websites     Website[]
  tags         ClientTag[]
  activities   ClientActivity[]
  auditScopes  AuditScope[]

  @@index([status, updatedAt])
  @@index([searchText])
}

model Website {
  id               String         @id @default(uuid())
  clientId         String
  url              String
  normalizedUrl    String
  normalizedDomain String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  client           Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pages            WebsitePage[]
  discoveryRuns    DiscoveryRun[]
  auditScopes      AuditScope[]

  @@index([clientId])
}

model WebsitePage {
  id                   String    @id @default(uuid())
  websiteId            String
  normalizedUrl        String
  observedUrl          String
  title                String?
  pageType             String
  statusCode           Int?
  failureCode          String?
  failureMessage       String?
  availability         String
  changeState          String
  recommendationState  String
  recommendationReason String
  selectionState       String    @default("default")
  firstDiscoveredAt    DateTime
  lastObservedAt       DateTime
  lastChangedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  website              Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, normalizedUrl])
  @@index([websiteId, availability, lastObservedAt])
  @@index([websiteId, pageType])
  @@index([websiteId, changeState])
  @@index([websiteId, selectionState])
}

model DiscoveryRun {
  id                    String    @id @default(uuid())
  websiteId             String
  status                String
  source                String
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  observedPageCount     Int       @default(0)
  discoveredUrlCount    Int       @default(0)
  successfulPageCount   Int       @default(0)
  failedPageCount       Int       @default(0)
  newPageCount          Int       @default(0)
  changedPageCount      Int       @default(0)
  unavailablePageCount  Int       @default(0)
  noLongerObservedCount Int       @default(0)
  failureMessage        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  website               Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, startedAt])
  @@index([status])
}

model AuditScope {
  id                 String           @id @default(uuid())
  clientId           String
  websiteId          String
  clientBusinessName String
  targetUrl          String
  normalizedDomain   String
  configurationJson  String
  reportFormatsJson  String
  requestedBy        String
  selectedPageCount  Int
  createdAt          DateTime         @default(now())
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  website            Website          @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  pages              AuditScopePage[]

  @@index([clientId, createdAt])
  @@index([websiteId, createdAt])
}

model AuditScopePage {
  scopeId       String
  pageId        String
  normalizedUrl String
  pageType      String
  scope         AuditScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@id([scopeId, pageId])
  @@index([scopeId, normalizedUrl])
}

model Tag {
  id             String      @id @default(uuid())
  name           String
  normalizedName String      @unique
  createdAt      DateTime    @default(now())
  clients        ClientTag[]
}

model ClientTag {
  clientId String
  tagId    String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientActivity {
  id        String   @id @default(uuid())
  clientId  String
  kind      String
  summary   String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}
