generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  id            String   @id
  schemaVersion Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Client {
  id              String              @id @default(uuid())
  businessName    String
  searchText      String
  status          String              @default("active")
  publicPhone     String?
  publicEmail     String?
  addressLine     String?
  locality        String?
  region          String?
  country         String?
  postalCode      String?
  category        String?
  notes           String?
  owner           String?
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  websites        Website[]
  tags            ClientTag[]
  activities      ClientActivity[]
  auditScopes     AuditScope[]
  auditJobs       AuditJob[]
  auditResults    AuditResultRecord[]
  reportArtifacts ReportArtifact[]

  @@index([status, updatedAt])
  @@index([searchText])
}

model Website {
  id               String              @id @default(uuid())
  clientId         String
  url              String
  normalizedUrl    String
  normalizedDomain String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pages            WebsitePage[]
  discoveryRuns    DiscoveryRun[]
  auditScopes      AuditScope[]
  auditJobs        AuditJob[]
  auditResults     AuditResultRecord[]
  reportArtifacts  ReportArtifact[]

  @@index([clientId])
}

model WebsitePage {
  id                   String    @id @default(uuid())
  websiteId            String
  normalizedUrl        String
  observedUrl          String
  title                String?
  pageType             String
  statusCode           Int?
  failureCode          String?
  failureMessage       String?
  availability         String
  changeState          String
  recommendationState  String
  recommendationReason String
  selectionState       String    @default("default")
  firstDiscoveredAt    DateTime
  lastObservedAt       DateTime
  lastChangedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  website              Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, normalizedUrl])
  @@index([websiteId, availability, lastObservedAt])
  @@index([websiteId, pageType])
  @@index([websiteId, changeState])
  @@index([websiteId, selectionState])
}

model DiscoveryRun {
  id                    String    @id @default(uuid())
  websiteId             String
  status                String
  source                String
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  observedPageCount     Int       @default(0)
  discoveredUrlCount    Int       @default(0)
  successfulPageCount   Int       @default(0)
  failedPageCount       Int       @default(0)
  newPageCount          Int       @default(0)
  changedPageCount      Int       @default(0)
  unavailablePageCount  Int       @default(0)
  noLongerObservedCount Int       @default(0)
  failureMessage        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  website               Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, startedAt])
  @@index([status])
}

model AuditScope {
  id                 String             @id @default(uuid())
  clientId           String
  websiteId          String
  clientBusinessName String
  targetUrl          String
  normalizedDomain   String
  configurationJson  String
  reportFormatsJson  String
  requestedBy        String
  selectedPageCount  Int
  createdAt          DateTime           @default(now())
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  website            Website            @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  pages              AuditScopePage[]
  job                AuditJob?
  result             AuditResultRecord?

  @@index([clientId, createdAt])
  @@index([websiteId, createdAt])
}

model AuditScopePage {
  scopeId       String
  pageId        String
  normalizedUrl String
  pageType      String
  scope         AuditScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@id([scopeId, pageId])
  @@index([scopeId, normalizedUrl])
}

model AuditJob {
  id                 String             @id @default(uuid())
  scopeId            String             @unique
  clientId           String
  websiteId          String
  clientBusinessName String
  targetUrl          String
  state              String             @default("queued")
  pagesCompleted     Int                @default(0)
  pagesTotal         Int
  failedPageCount    Int                @default(0)
  warningCount       Int                @default(0)
  warningsJson       String             @default("[]")
  attempt            Int                @default(1)
  failureCode        String?
  failureMessage     String?
  resultJson         String?
  outputDirectory    String?
  cancelRequestedAt  DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  scope              AuditScope         @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  website            Website            @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  resultRecord       AuditResultRecord?
  reportArtifacts    ReportArtifact[]

  @@index([clientId, createdAt])
  @@index([state, createdAt])
  @@index([websiteId, createdAt])
}

model AuditResultRecord {
  id                  String           @id @default(uuid())
  jobId               String           @unique
  scopeId             String           @unique
  clientId            String
  websiteId           String
  auditId             String           @unique
  schemaVersion       String
  resultState         String
  overallScore        Float
  findingCountsJson   String
  categoryScoresJson  String
  canonicalResultJson String
  startedAt           DateTime
  completedAt         DateTime
  retainedUntil       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  job                 AuditJob         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  scope               AuditScope       @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  client              Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  website             Website          @relation(fields: [websiteId], references: [id], onDelete: Restrict)
  artifacts           ReportArtifact[]

  @@index([clientId, completedAt])
  @@index([resultState, completedAt])
  @@index([websiteId, completedAt])
}

model ReportArtifact {
  id            String            @id @default(uuid())
  resultId      String
  jobId         String
  clientId      String
  websiteId     String
  format        String
  fileName      String
  storedPath    String?
  status        String
  verifiedAt    DateTime?
  retainedUntil DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  result        AuditResultRecord @relation(fields: [resultId], references: [id], onDelete: Cascade)
  job           AuditJob          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  client        Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  website       Website           @relation(fields: [websiteId], references: [id], onDelete: Restrict)

  @@unique([jobId, format])
  @@index([clientId, createdAt])
  @@index([resultId])
  @@index([status, createdAt])
  @@index([websiteId, createdAt])
}

model Tag {
  id             String      @id @default(uuid())
  name           String
  normalizedName String      @unique
  createdAt      DateTime    @default(now())
  clients        ClientTag[]
}

model ClientTag {
  clientId String
  tagId    String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([tagId])
}

model ClientActivity {
  id        String   @id @default(uuid())
  clientId  String
  kind      String
  summary   String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}
