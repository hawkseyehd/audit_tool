{
  "name": "website-audit-tool",
  "version": "0.1.0",
  "private": true,
  "description": "A professional CLI for evidence-based website audits.",
  "author": "Hawks Eye",
  "license": "UNLICENSED",
  "type": "module",
  "main": ".webpack/main",
  "bin": {
    "website-audit": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "browser:install": "playwright install chromium",
    "desktop:prepare": "node tools/prepare-packaged-browser.mjs",
    "desktop:inspect": "tsx tests/desktop/package-contents.ts",
    "build": "tsc -p tsconfig.build.json",
    "desktop:make": "pnpm desktop:prepare && electron-forge make",
    "desktop:package": "pnpm desktop:prepare && electron-forge package",
    "desktop:runtime-smoke": "tsx tests/desktop/packaged-browser-smoke.ts",
    "desktop:smoke": "tsx tests/desktop/package-smoke.ts",
    "desktop:start": "electron-forge start",
    "dev": "tsx src/cli/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:status": "prisma migrate status",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "commander": "^15.0.0",
    "dotenv": "16.6.1",
    "ipaddr.js": "^2.4.0",
    "lighthouse": "^13.4.0",
    "lucide-react": "^1.25.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@oxc-project/types": "0.142.0",
    "@rolldown/binding-win32-x64-msvc": "1.2.1",
    "@rolldown/pluginutils": "1.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "css-loader": "^7.1.4",
    "electron": "^43.2.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prisma": "6.19.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4"
  }
}
